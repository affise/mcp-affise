{
  "name": "@affise/mcp-server",
  "version": "2.0.1",
  "description": "MCP server for the Affise public API: stdio transport, 23 tools, 6 analysis prompts",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "affise-mcp-server": "./build/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "npm run security:audit && tsc && chmod +x build/index.js",
    "build:unsafe": "tsc && chmod +x build/index.js",
    "prepublishOnly": "npm run build",
    "start": "npm run build && node build/index.js",
    "clean": "rm -rf build dist coverage",
    "rebuild": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit tests/services",
    "test:integration": "vitest run tests/integration",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix",
    "security:check": "npm outdated && npm audit",
    "docker:build": "docker build -t affise-mcp-server .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "build-dxt": "npm run build && npm prune --omit=dev && npm run package-dxt && npm install --no-audit --no-fund",
    "package-dxt": "npx -y -p @anthropic-ai/dxt dxt pack",
    "validate-dxt": "npx -y -p @anthropic-ai/dxt dxt validate manifest.json",
    "test-dxt": "npm run build-dxt && npm run validate-dxt"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.15.2",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.27",
    "@vitest/coverage-v8": "^4.1.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "affise",
    "api",
    "affiliate",
    "marketing",
    "analytics"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/affise/mcp-affise.git"
  },
  "homepage": "https://github.com/affise/mcp-affise#readme",
  "bugs": {
    "url": "https://github.com/affise/mcp-affise/issues"
  }
}
